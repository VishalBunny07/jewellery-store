
// use prisma-8

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  phone         String?  @unique
  passwordHash  String
  role          String   @default("CUSTOMER")
  status        String   @default("ACTIVE")
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)

  addresses      Address[]
  otpVerifications OtpVerification[]
  cart           Cart?
  wishlist       Wishlist?
  orders         Order[]
  adminActivities AdminActivity[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Address {
  id          Int     @id @default(autoincrement())
  userId      Int
  fullName    String
  phone       String
  addressLine1 String
  addressLine2 String?
  landmark    String?
  city        String
  state       String
  postalCode  String
  country     String  @default("India")
  addressType String  @default("HOME")
  isDefault   Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([userId])
}

model OtpVerification {
  id          Int       @id @default(autoincrement())
  userId      Int?
  destination String
  otpHash     String
  purpose     String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @onCreate(now())

  @@index([destination, purpose])
  @@index([userId])
}

// ============================================
// CATEGORIES & PRODUCTS
// ============================================

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  image       String?
  bannerImage String?
  parentId    Int?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([parentId])
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  sku            String   @unique
  description    String?
  shortDescription String?
  categoryId     Int
  price          Decimal
  compareAtPrice Decimal?
  costPrice      Decimal?
  material       String?
  metalType      String?
  purity         String?
  weight         Decimal?
  gender         String?
  occasion       String?
  attributes     Json?
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  isNew          Boolean  @default(false)
  isBestSeller   Boolean  @default(false)

  category       Category       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  inventory      Inventory[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([categoryId])
  @@index([isActive])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  imageUrl  String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @onCreate(now())

  @@index([productId])
}

// ============================================
// SUPPLIERS & INVENTORY
// ============================================

model Supplier {
  id            Int     @id @default(autoincrement())
  name          String
  companyName   String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  gstNumber     String?
  notes         String?
  isActive      Boolean @default(true)

  inventory      Inventory[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  shipments      Shipment[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Inventory {
  id           Int    @id @default(autoincrement())
  productId    Int
  supplierId   Int?
  sourceCode   String
  sourceType   String @default("OWN")
  location     String?
  quantity     Int    @default(0)
  reserved     Int    @default(0)
  reorderLevel Int    @default(0)

  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  stockMovements StockMovement[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@unique([productId, sourceCode])
  @@index([supplierId])
}

model StockMovement {
  id          Int     @id @default(autoincrement())
  inventoryId Int
  supplierId  Int?
  movementType String
  quantity    Int
  reference   String?
  notes       String?

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @onCreate(now())

  @@index([inventoryId])
  @@index([supplierId])
}

// ============================================
// CART & WISHLIST
// ============================================

model Cart {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Wishlist {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user  User           @relation(fields: [userId], references: [id])
  items WishlistItem[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model WishlistItem {
  id         Int @id @default(autoincrement())
  wishlistId Int
  productId  Int

  wishlist Wishlist @relation(fields: [wishlistId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @onCreate(now())

  @@unique([wishlistId, productId])
  @@index([productId])
}

// ============================================
// ORDERS & ORDER ITEMS
// ============================================

model Order {
  id                Int     @id @default(autoincrement())
  orderNumber       String  @unique
  userId            Int
  status            String  @default("PENDING")
  paymentStatus     String  @default("PENDING")
  fulfilmentStatus  String  @default("UNFULFILLED")

  subtotal          Decimal
  discountAmount    Decimal @default(0)
  shippingAmount    Decimal @default(0)
  taxAmount         Decimal @default(0)
  totalAmount       Decimal

  couponCode        String?
  shippingFullName  String
  shippingPhone     String
  shippingAddress1  String
  shippingAddress2  String?
  shippingLandmark  String?
  shippingCity      String
  shippingState     String
  shippingPostalCode String
  shippingCountry   String  @default("India")

  notes             String?

  user      User      @relation(fields: [userId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  refunds   Refund[]
  shipments Shipment[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  productId       Int
  supplierId      Int?
  shipmentId      Int?

  productName     String
  productSku      String
  productImage    String?
  unitPrice       Decimal
  quantity        Int
  totalPrice      Decimal
  fulfilmentSource String @default("OWN")

  order    Order     @relation(fields: [orderId], references: [id])
  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([orderId])
  @@index([productId])
  @@index([supplierId])
  @@index([shipmentId])
}

// ============================================
// PAYMENTS & REFUNDS
// ============================================

model Payment {
  id                Int     @id @default(autoincrement())
  orderId           Int
  provider          String
  providerPaymentId String?
  providerOrderId   String?
  amount            Decimal
  currency          String  @default("INR")
  status            String  @default("PENDING")
  method            String?
  transactionId     String?
  rawResponse       Json?

  order Order @relation(fields: [orderId], references: [id])
  refunds Refund[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([orderId])
  @@index([providerPaymentId])
}

model Refund {
  id               Int     @id @default(autoincrement())
  orderId          Int
  paymentId        Int?
  providerRefundId String?
  amount           Decimal
  reason           String?
  status           String  @default("PENDING")

  order   Order    @relation(fields: [orderId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([orderId])
  @@index([paymentId])
}

// ============================================
// SHIPMENTS
// ============================================

model Shipment {
  id              Int     @id @default(autoincrement())
  orderId         Int
  supplierId      Int?
  fulfilmentType  String  @default("OWN")
  provider        String?
  trackingNumber  String?
  trackingUrl     String?
  status          String  @default("PENDING")
  shippingAmount  Decimal @default(0)
  shippedAt       DateTime?
  deliveredAt     DateTime?
  notes           String?

  order      Order       @relation(fields: [orderId], references: [id])
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  orderItems OrderItem[]

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([orderId])
  @@index([supplierId])
  @@index([status])
}

// ============================================
// COUPONS
// ============================================

model Coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  description   String?
  discountType  String
  discountValue Decimal
  minimumAmount Decimal?
  maximumDiscount Decimal?
  usageLimit    Int?
  usageCount    Int      @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean  @default(true)

  createdAt DateTime @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([isActive])
}

// ============================================
// ADMIN ACTIVITY LOG
// ============================================

model AdminActivity {
  id          Int     @id @default(autoincrement())
  userId      Int
  action      String
  entityType  String
  entityId    Int?
  description String?
  ipAddress   String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @onCreate(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
